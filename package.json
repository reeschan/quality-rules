{
  "name": "quality-rules-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the quality-rules packages",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "test": "pnpm --recursive test",
    "build": "pnpm --recursive build",
    "check:example": "pnpm --filter @quality-rules/example-react-app check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
