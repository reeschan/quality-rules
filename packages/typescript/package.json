{
  "name": "@reeschan/quality-rules-typescript",
  "version": "0.1.0",
  "description": "Selectable code rules for TypeScript projects: packs of lint rules and conventions, custom lint rules that run on oxlint and ESLint, and the quality-rules CLI",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeschan/quality-rules.git",
    "directory": "packages/typescript"
  },
  "keywords": [
    "oxlint",
    "eslint",
    "eslintplugin",
    "biome",
    "lint",
    "rules"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "quality-rules": "./dist/cli/main.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./conventions/*": "./dist/conventions/*",
    "./packs/*": "./packs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "packs"
  ],
  "qualityRules": {
    "packs": "packs",
    "conventions": "dist/conventions",
    "rules": "."
  },
  "scripts": {
    "build": "tsdown src/plugin.ts src/cli/main.ts --format esm --dts --clean && node scripts/bundle-conventions.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@reeschan/quality-rules-common": "workspace:*",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.73.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "knip": "^6.46.1",
    "lint-fixture-runner": "workspace:*",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "jscpd": "^5.4.3"
  }
}
