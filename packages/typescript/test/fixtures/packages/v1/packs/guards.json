{
  "description": "Sample guards against leftover debugging code",
  "rules": [
    {
      "id": "no-console",
      "tool": "oxlint",
      "description": "Disallow console calls",
      "added": "1.0.0",
      "config": {
        "oxlint": {
          "rules": {
            "no-console": "error"
          }
        }
      }
    },
    {
      "id": "no-debugger",
      "tool": "oxlint",
      "description": "Disallow debugger statements",
      "added": "1.0.0",
      "config": {
        "oxlint": {
          "rules": {
            "no-debugger": "error"
          }
        }
      }
    },
    {
      "id": "quality-rules/no-sample-call",
      "tool": "oxlint",
      "description": "Disallow calls to a function named sample",
      "added": "1.0.0",
      "config": {
        "oxlint": {
          "rules": {
            "quality-rules/no-sample-call": "error"
          }
        }
      }
    }
  ]
}
